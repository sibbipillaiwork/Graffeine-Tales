<section class="section-padding categories-section" id="category-section">
      <div class="container categories-container">
        
        <div class="category-header-wrap">
          <h2 class="category-strip-heading">SHOP BY CATEGORY.</h2>
        </div>

        <div class="categories-strip-wrapper">
          <div class="categories-strip-track" id="categories-strip-track">
            
            <!-- Category 1: Stationaries -->
            <a href="#catalogue-section" class="category-pill-card" data-category="Stationaries" aria-label="Shop Stationaries">
              <div class="category-card-media">
                <img src="{{ \'cat_stationaries.jpg\' | asset_url }}" alt="Stationaries" loading="lazy" />
                <div class="category-card-overlay"></div>
              </div>
              <div class="category-card-info">
                <span class="category-card-name">Stationaries</span>
                <span class="category-card-arrow" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="9 18 15 12 9 6"></polyline>
                  </svg>
                </span>
              </div>
            </a>

            <!-- Category 2: Journals -->
            <a href="#catalogue-section" class="category-pill-card" data-category="Journals" aria-label="Shop Journals">
