  <!-- =========================================================================
       Interactive Flip-Through Inner Pages Component (Digital Book Preview)
       ========================================================================= -->
  <section class="py-20 sm:py-24 bg-[#F8F5ED] border-t border-[#C6B58E]/30 overflow-hidden relative select-none" id="shopify-flip-through-section" aria-label="Interactive Journal Page Preview">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading: DM Serif Display, Espresso Charcoal (#363638), Generous Spacing -->
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
        <h2 class="font-serif-display text-3xl sm:text-4xl lg:text-5xl text-[#363638] tracking-tight">
          {{ section.settings.flip_heading | default: 'Flip through a few inner pages!' }}
        </h2>
      </div>

      <!-- Interactive Book Display Container with Realistic Desk Shadow & Spine -->
      <div class="relative mx-auto flex items-center justify-center p-3 sm:p-6 sm:pb-8 rounded-3xl bg-white/60 border border-[#C6B58E]/40 shadow-tactile-lg backdrop-blur-sm" id="shopify-flip-desk">
        
        <!-- Left & Right Hover Drag / Click Hints for Desktop -->
        <div class="hidden md:flex absolute top-4 left-6 items-center gap-1.5 text-[11px] font-semibold text-[#927B53]/70 pointer-events-none">
          <span>&larr; Drag corner or tap to turn back</span>
        </div>
        <div class="hidden md:flex absolute top-4 right-6 items-center gap-1.5 text-[11px] font-semibold text-[#927B53]/70 pointer-events-none">
          <span>Drag corner or tap to turn next &rarr;</span>
        </div>

        <!-- Canvas Mount Target for St.PageFlip -->
        <div id="shopify-page-flip-book" class="mx-auto flex items-center justify-center cursor-grab active:cursor-grabbing max-w-full"></div>
      </div>

      <!-- Navigation Controls ("< BACK" / "NEXT >") styled in Deep Coffee (#4D351D) -->
      <div class="flex items-center justify-center gap-4 sm:gap-6 mt-6 sm:mt-8">
        <button type="button" 
                id="shopify-flip-back" 
                onclick="changeShopifyFlip(-1)" 
                class="px-8 sm:px-10 py-3 rounded-full border border-[#4D351D]/30 text-[#4D351D]/40 bg-white/70 text-xs font-bold uppercase tracking-widest transition-all cursor-not-allowed select-none shadow-sm disabled:opacity-40" 
                aria-label="Previous Page"
                disabled>
          &lsaquo; Back
        </button>

        <button type="button" 
                id="shopify-flip-next" 
                onclick="changeShopifyFlip(1)" 
                class="px-8 sm:px-10 py-3 rounded-full border border-[#4D351D] bg-[#4D351D] text-[#E9DFC2] hover:bg-[#363638] text-xs font-bold uppercase tracking-widest transition-all shadow-tactile select-none hover:shadow-lg" 
                aria-label="Next Page">
          Next &rsaquo;
        </button>
      </div>

    </div>
  </section>

  <script src="{{ 'page-flip.browser.js' | asset_url }}"></script>
  <script>
    var shopifyFlipPages = [];

    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.page_image != blank %}
          shopifyFlipPages.push("{{ block.settings.page_image | image_url: width: 900 }}");
        {% endif %}
      {% endfor %}
    {% endif %}

    // Fallback to high-resolution atelier journal pages if no custom images uploaded in theme editor
    if (shopifyFlipPages.length === 0) {
      shopifyFlipPages = [
        "{{ 'flip_cover.jpg' | asset_url }}",
        "{{ 'flip_page_01_belonging.jpg' | asset_url }}",
        "{{ 'flip_page_02_vision.jpg' | asset_url }}",
        "{{ 'flip_page_03_monthly.jpg' | asset_url }}",
        "{{ 'flip_page_04_habits.jpg' | asset_url }}",
        "{{ 'flip_page_05_weekly_left.jpg' | asset_url }}",
        "{{ 'flip_page_06_weekly_right.jpg' | asset_url }}",
        "{{ 'flip_back_cover.jpg' | asset_url }}"
      ];
    }

    var currentShopifyFlip = 0;
    var shopifyPageFlip = null;

    function initShopifyPageFlip() {
      var bookEl = document.getElementById('shopify-page-flip-book');
      if (!bookEl || typeof St === 'undefined' || !St.PageFlip) return;

      var isMobile = window.innerWidth < 768;
      var width = isMobile ? Math.min(window.innerWidth - 64, 340) : 380;
      var height = Math.round(width * 1.333);

      try {
        shopifyPageFlip = new St.PageFlip(bookEl, {
          width: width,
          height: height,
          size: 'fixed',
          minWidth: 260,
          maxWidth: 440,
          minHeight: 347,
          maxHeight: 587,
          maxShadowOpacity: 0.55,
          showCover: true,
          mobileScrollSupport: true,
          usePortrait: true,
          flippingTime: 700,
          drawShadow: true,
          showPageCorners: true,
          useMouseEvents: true,
          disableFlipByClick: false
        });

        shopifyPageFlip.loadFromImages(shopifyFlipPages);

        shopifyPageFlip.on('flip', function(e) {
          currentShopifyFlip = e.data;
          updateShopifyFlip(currentShopifyFlip);
        });

        shopifyPageFlip.on('init', function() {
          updateShopifyFlip(0);
        });
      } catch (err) {
        console.warn('Shopify PageFlip init notice:', err);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShopifyPageFlip);
    } else {
      initShopifyPageFlip();
    }

    function updateShopifyFlip(index) {
      if (typeof index === 'number') currentShopifyFlip = index;
      var prevBtn = document.getElementById('shopify-flip-back');
      var nextBtn = document.getElementById('shopify-flip-next');

      if (prevBtn) {
        if (currentShopifyFlip === 0) {
          prevBtn.disabled = true;
          prevBtn.className = 'px-8 sm:px-10 py-3 rounded-full border border-[#4D351D]/30 text-[#4D351D]/40 bg-white/70 text-xs font-bold uppercase tracking-widest transition-all cursor-not-allowed select-none shadow-sm';
        } else {
          prevBtn.disabled = false;
          prevBtn.className = 'px-8 sm:px-10 py-3 rounded-full border border-[#4D351D] text-[#4D351D] bg-white hover:bg-[#4D351D] hover:text-[#E9DFC2] text-xs font-bold uppercase tracking-widest transition-all shadow-sm select-none hover:shadow';
        }
      }

      if (nextBtn) {
        if (currentShopifyFlip === shopifyFlipPages.length - 1) {
          nextBtn.disabled = true;
          nextBtn.className = 'px-8 sm:px-10 py-3 rounded-full border border-[#4D351D]/30 text-[#4D351D]/40 bg-white/70 text-xs font-bold uppercase tracking-widest transition-all cursor-not-allowed select-none shadow-sm';
        } else {
          nextBtn.disabled = false;
          nextBtn.className = 'px-8 sm:px-10 py-3 rounded-full border border-[#4D351D] bg-[#4D351D] text-[#E9DFC2] hover:bg-[#363638] text-xs font-bold uppercase tracking-widest transition-all shadow-tactile select-none hover:shadow-lg';
        }
      }
    }

    function changeShopifyFlip(delta) {
      if (shopifyPageFlip) {
        if (delta > 0) {
          shopifyPageFlip.flipNext('bottom');
        } else {
          shopifyPageFlip.flipPrev('bottom');
        }
      }
    }

    function goToShopifyFlip(idx) {
      if (shopifyPageFlip) {
        shopifyPageFlip.flip(idx, 'bottom');
      }
    }
  </script>
</div>
