{% comment %}
  Graffeine Tales — Journal & Diaries Luxury PDP Section (Shopify OS 2.0)
{% endcomment %}
<div class="journal-pdp-wrapper bg-[#F8F5ED] text-[#363638] antialiased pb-20 sm:pb-24">
  <style>
    @keyframes btnShimmer {
      0% { transform: translateX(-150%) skewX(-20deg); }
      35%, 100% { transform: translateX(250%) skewX(-20deg); }
    }
    .btn-shimmer {
      position: relative;
      overflow: hidden;
    }
    .btn-shimmer::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 60%;
      height: 100%;
      background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.35) 50%, rgba(255,255,255,0) 100%);
      transform: translateX(-150%) skewX(-20deg);
      animation: btnShimmer 3s ease-in-out infinite;
      pointer-events: none;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    @keyframes pagePeelCurl {
      0%, 100% {
        transform: translate(0, 0) rotate(0deg);
        filter: drop-shadow(-2px -2px 3px rgba(77, 53, 29, 0.22));
      }
      15% {
        transform: translate(-3px, -3px) rotate(-3deg);
        filter: drop-shadow(-5px -5px 7px rgba(77, 53, 29, 0.38));
      }
      30% {
        transform: translate(-1px, -1px) rotate(-1deg);
        filter: drop-shadow(-3px -3px 4px rgba(77, 53, 29, 0.25));
      }
      45% {
        transform: translate(-4px, -4px) rotate(-4deg);
        filter: drop-shadow(-6px -6px 9px rgba(77, 53, 29, 0.42));
      }
      60%, 100% {
        transform: translate(0, 0) rotate(0deg);
        filter: drop-shadow(-2px -2px 3px rgba(77, 53, 29, 0.22));
      }
    }
    .page-peel-fold {
      animation: pagePeelCurl 4.2s ease-in-out infinite;
      clip-path: polygon(100% 0, 0 100%, 100% 100%);
    }
    #shopify-flip-page-peel-hint:hover .page-peel-fold {
      animation-play-state: paused;
      transform: translate(-5px, -5px) rotate(-5deg);
      filter: drop-shadow(-7px -7px 11px rgba(77, 53, 29, 0.48));
    }
  </style>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 xl:gap-14 items-start">
      <div class="lg:col-span-7 space-y-3 sm:space-y-4 lg:sticky lg:top-28">
        <!-- Main Image Stage: 1:1 Aspect Ratio Scrollable Carousel -->
        <div class="relative bg-[#EFE9DC] rounded-2xl sm:rounded-3xl overflow-hidden border border-[#C6B58E]/40 shadow-tactile group aspect-square flex items-center justify-center select-none" id="shopify-gallery-stage">
          <div id="shopify-carousel-track" class="flex w-full h-full overflow-x-auto snap-x snap-mandatory scroll-smooth no-scrollbar">
            {% if product.images.size > 0 %}
              {% for image in product.images %}
                <div class="w-full h-full flex-shrink-0 snap-center aspect-square flex items-center justify-center">
                  <img src="{{ image | image_url: width: 1200 }}" alt="{{ image.alt | default: product.title | escape }}" class="w-full h-full object-cover" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" />
                </div>
              {% endfor %}
            {% else %}
              <div class="w-full h-full flex-shrink-0 snap-center aspect-square flex items-center justify-center">
                <img src="{{ 'prod_journal.jpg' | asset_url }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover" />
              </div>
              <div class="w-full h-full flex-shrink-0 snap-center aspect-square flex items-center justify-center">
                <img src="{{ 'cat_journals.jpg' | asset_url }}" alt="Lay Flat Spread" class="w-full h-full object-cover" />
              </div>
              <div class="w-full h-full flex-shrink-0 snap-center aspect-square flex items-center justify-center">
                <img src="{{ 'flip_page_03_monthly.jpg' | asset_url }}" alt="Planner Spread" class="w-full h-full object-cover" />
              </div>
              <div class="w-full h-full flex-shrink-0 snap-center aspect-square flex items-center justify-center">
                <img src="{{ 'flip_habits.jpg' | asset_url }}" alt="Habit Tracker" class="w-full h-full object-cover" />
              </div>
              <div class="w-full h-full flex-shrink-0 snap-center aspect-square flex items-center justify-center">
                <img src="{{ 'prod_waxseal.jpg' | asset_url }}" alt="Wax Seal Box" class="w-full h-full object-cover" />
              </div>
            {% endif %}
          </div>
          <!-- Navigation Arrows -->
          <button type="button" onclick="scrollShopifyCarousel(-1)" class="absolute left-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/90 hover:bg-white text-[#363638] shadow-md backdrop-blur-sm flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 sm:opacity-80" aria-label="Previous image">
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button type="button" onclick="scrollShopifyCarousel(1)" class="absolute right-3 top-1/2 -translate-y-1/2 z-20 w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/90 hover:bg-white text-[#363638] shadow-md backdrop-blur-sm flex items-center justify-center transition-all opacity-0 group-hover:opacity-100 sm:opacity-80" aria-label="Next image">
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      </div>

      <div class="lg:col-span-5 bg-white/95 rounded-2xl sm:rounded-3xl p-5 sm:p-8 border border-[#C6B58E]/40 shadow-tactile-lg space-y-4 sm:space-y-6">
        <div>
          <h1 class="font-serif-display text-2xl sm:text-3xl lg:text-4xl text-[#363638] leading-tight">{{ product.title | default: 'The 2027 Bound Chronicle &amp; Daily Journal' }}</h1>
        </div>

        <div class="py-3 sm:py-4 border-y border-[#C6B58E]/30 flex items-baseline justify-between">
          <div>
            <div class="flex items-baseline gap-3">
              <span class="font-serif-display text-3xl sm:text-4xl font-bold text-[#4D351D]">{{ product.price | money | default: '₹1,299' }}</span>
              <span class="text-base text-[#363638]/40 line-through">₹1,699</span>
              <span class="bg-[#C85A32]/10 text-[#C85A32] text-xs font-bold px-2.5 py-0.5 rounded-full">SAVE 24%</span>
            </div>
            <p class="text-xs text-[#363638]/60 mt-1">Inclusive of all domestic taxes &bull; Custom kraft box included</p>
          </div>
        </div>

        {% form 'product', product, id: 'journal-pdp-form' %}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
          <div class="flex items-center gap-3 mb-4">
            <button type="submit" name="add" class="btn-shimmer flex-1 bg-[#4D351D] hover:bg-[#363638] text-[#E9DFC2] py-4 px-6 rounded-full font-bold text-sm tracking-wide flex items-center justify-center gap-3 shadow-tactile transition-all">
              <svg class="w-5 h-5 relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
              <span class="relative z-10">Add to Cart</span>
            </button>
          </div>
        {% endform %}

        <!-- Editorial Lead Pitch Paragraph (Inspired by Alicia Souza PDP Structure) -->
        <p class="text-xs sm:text-sm text-[#363638]/80 leading-relaxed font-normal pt-4 border-t border-[#C6B58E]/40">
          <strong class="text-[#363638] font-semibold">Plan every day with ease using our 2027 Daily Planner!</strong> Featuring a daily layout, along with monthly grids, and a habit tracker which helps you stay organized and on top of your goals. The premium printed bookcloth cover with metallic gold foiling adds a touch of luxury, making it perfect for work, studio, or personal planning. Durable, stylish, and thoughtfully designed &ndash; your must-have planner for 2027!
        </p>

        <!-- Dropdown Accordion Stack -->
        <div class="border-t border-[#C6B58E]/40 divide-y divide-[#C6B58E]/40" id="shopify-journal-accordion">
          <!-- 1. What's Inside? -->
          <div class="accordion-item">
            <button type="button" class="w-full py-4 text-left flex items-center justify-between text-sm sm:text-base font-semibold text-[#363638] hover:text-[#4D351D] transition-colors group" onclick="toggleDetailsAccordion(this)">
              <span>What’s Inside?</span>
              <svg class="w-4 h-4 text-[#927B53] transition-transform duration-300 group-hover:text-[#4D351D] chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
            </button>
            <div class="accordion-panel max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="pb-5 pt-1 text-xs text-[#363638]/80 space-y-2 leading-relaxed">
                <ul class="space-y-2 pl-1">
                  <li class="flex items-start gap-2"><span class="text-[#4D351D] font-bold">✦</span><span><strong>1x The 2027 Bound Chronicle Hardcover Planner</strong> (A5 / 224 Numbered Ivory Pages)</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#4D351D] font-bold">✦</span><span><strong>4x Complimentary Gilded Planning Sticker Sheets</strong> (Over 180+ die-cut stickers)</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#4D351D] font-bold">✦</span><span><strong>1x Companion A6 Pocket Notes Booklet</strong> (32 pages, saddle-stitched for on-the-go ideas)</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#4D351D] font-bold">✦</span><span><strong>1x Linen-Reinforced Expandable Memory Pocket</strong> in the rear cover</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#4D351D] font-bold">✦</span><span><strong>2x Woven Silk Ribbon Markers</strong> (Espresso Charcoal &amp; Golden Sand)</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#4D351D] font-bold">✦</span><span><strong>1x Sustainable Kraft Keepsake Gift Box</strong> with metallic gold wax seal emblem</span></li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 2. Product Features -->
          <div class="accordion-item">
            <button type="button" class="w-full py-4 text-left flex items-center justify-between text-sm sm:text-base font-semibold text-[#363638] hover:text-[#4D351D] transition-colors group" onclick="toggleDetailsAccordion(this)">
              <span>Product Features</span>
              <svg class="w-4 h-4 text-[#927B53] transition-transform duration-300 group-hover:text-[#4D351D] chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
            </button>
            <div class="accordion-panel max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="pb-5 pt-1 text-xs text-[#363638]/80 space-y-2.5 leading-relaxed">
                <div class="grid grid-cols-2 gap-2 text-xs">
                  <div class="p-2.5 bg-[#F8F5ED] rounded-lg border border-[#C6B58E]/30">
                    <span class="text-[10px] uppercase font-bold text-[#927B53] block">Paper Stock</span>
                    <strong class="text-[#363638]">100 GSM Natural Paper</strong>
                    <p class="text-[11px] text-[#363638]/70 mt-0.5">Bleed-proof bamboo-cotton, fountain-pen safe.</p>
                  </div>
                  <div class="p-2.5 bg-[#F8F5ED] rounded-lg border border-[#C6B58E]/30">
                    <span class="text-[10px] uppercase font-bold text-[#927B53] block">Binding</span>
                    <strong class="text-[#363638]">180° Smyth Sewn</strong>
                    <p class="text-[11px] text-[#363638]/70 mt-0.5">True lay-flat binding with reinforced cloth spine.</p>
                  </div>
                  <div class="p-2.5 bg-[#F8F5ED] rounded-lg border border-[#C6B58E]/30">
                    <span class="text-[10px] uppercase font-bold text-[#927B53] block">Size &amp; Pages</span>
                    <strong class="text-[#363638]">A5 (148 x 210 mm)</strong>
                    <p class="text-[11px] text-[#363638]/70 mt-0.5">224 numbered ivory pages, 520 grams.</p>
                  </div>
                  <div class="p-2.5 bg-[#F8F5ED] rounded-lg border border-[#C6B58E]/30">
                    <span class="text-[10px] uppercase font-bold text-[#927B53] block">Cover Finish</span>
                    <strong class="text-[#363638]">Japanese Bookcloth</strong>
                    <p class="text-[11px] text-[#363638]/70 mt-0.5">Tactile textured cloth with gold hot foil stamping.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 3. Planner Layout Includes -->
          <div class="accordion-item">
            <button type="button" class="w-full py-4 text-left flex items-center justify-between text-sm sm:text-base font-semibold text-[#363638] hover:text-[#4D351D] transition-colors group" onclick="toggleDetailsAccordion(this)">
              <span>Planner Layout Includes</span>
              <svg class="w-4 h-4 text-[#927B53] transition-transform duration-300 group-hover:text-[#4D351D] chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
            </button>
            <div class="accordion-panel max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="pb-5 pt-1 text-xs text-[#363638]/80 space-y-2 leading-relaxed">
                <ul class="space-y-1.5 pl-1">
                  <li class="flex items-start gap-2"><span class="text-[#927B53]">✔</span><span><strong>Yearly Life Blueprint &amp; Goals:</strong> 4 pages dedicated to quarterly aspirations and reading lists.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#927B53]">✔</span><span><strong>12 Monthly Panoramic Spreads:</strong> Double-page calendar view with moon phases and budget tracking.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#927B53]">✔</span><span><strong>52 Weekly Focus Dashboards:</strong> Weekday schedule with daily gratitude prompts and habit check-boxes.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#927B53]">✔</span><span><strong>Monthly Habit &amp; Ritual Trackers:</strong> 31-day visual tracking for sleep, hydration, exercise, and reading.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#927B53]">✔</span><span><strong>40 Dot-Grid Ivory Sandbox Pages:</strong> Perforated 5mm dot grid for mindmaps, sketches, and notes.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#927B53]">✔</span><span><strong>Mid-Year Review &amp; Year-End Reflection:</strong> Guided prompts to celebrate growth.</span></li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 4. Features Of The Sticker Book -->
          <div class="accordion-item">
            <button type="button" class="w-full py-4 text-left flex items-center justify-between text-sm sm:text-base font-semibold text-[#363638] hover:text-[#4D351D] transition-colors group" onclick="toggleDetailsAccordion(this)">
              <span>Features Of The Sticker Book</span>
              <svg class="w-4 h-4 text-[#927B53] transition-transform duration-300 group-hover:text-[#4D351D] chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
            </button>
            <div class="accordion-panel max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="pb-5 pt-1 text-xs text-[#363638]/80 space-y-2 leading-relaxed">
                <p class="font-medium text-[#363638]">Includes 4 full sheets with over 180+ die-cut matte planning stickers:</p>
                <ul class="space-y-1.5 pl-1">
                  <li class="flex items-start gap-2"><span class="text-[#D4AF37]">✦</span><span><strong>Sheet 1 (Functional Headers):</strong> Appointments, deadlines, paydays, flights, doctor, self-care.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#D4AF37]">✦</span><span><strong>Sheet 2 (Coffee &amp; Cozy Rituals):</strong> Illustrated mugs, steaming espresso, book stacks, rainy mornings.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#D4AF37]">✦</span><span><strong>Sheet 3 (Gold Foil Washi &amp; Accents):</strong> Metallic gold hot-stamped stars, washi tape ribbons, and flourish borders.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#D4AF37]">✦</span><span><strong>Sheet 4 (12 Monthly Index Tabs):</strong> Laminated index tabs from Jan to Dec to flip between months effortlessly.</span></li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 5. Features Of The Pocket Planner -->
          <div class="accordion-item">
            <button type="button" class="w-full py-4 text-left flex items-center justify-between text-sm sm:text-base font-semibold text-[#363638] hover:text-[#4D351D] transition-colors group" onclick="toggleDetailsAccordion(this)">
              <span>Features Of The Pocket Planner</span>
              <svg class="w-4 h-4 text-[#927B53] transition-transform duration-300 group-hover:text-[#4D351D] chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
            </button>
            <div class="accordion-panel max-h-0 overflow-hidden transition-all duration-300 ease-in-out">
              <div class="pb-5 pt-1 text-xs text-[#363638]/80 space-y-2 leading-relaxed">
                <p>A slim companion pocket notebook designed for effortless mobility:</p>
                <ul class="space-y-1.5 pl-1">
                  <li class="flex items-start gap-2"><span class="text-[#4D351D]">▪</span><span><strong>Size:</strong> A6 Slim (105 x 148 mm) &bull; 32 pages saddle-stitched.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#4D351D]">▪</span><span><strong>Layout:</strong> Unruled &amp; dotted micro-spreads for sudden sparks of creativity and cafe notes.</span></li>
                  <li class="flex items-start gap-2"><span class="text-[#4D351D]">▪</span><span><strong>Portability:</strong> Slips into jacket pockets, small clutches, or inside the main journal's back envelope.</span></li>
                </ul>
              </div>
            </div>
          </div>

          <!-- 6. Shipping Timeline (Open by default as in screenshot) -->
          <div class="accordion-item">
            <button type="button" class="w-full py-4 text-left flex items-center justify-between text-sm sm:text-base font-semibold text-[#363638] hover:text-[#4D351D] transition-colors group active-accordion" onclick="toggleDetailsAccordion(this)">
              <span>Shipping Timeline</span>
              <svg class="w-4 h-4 text-[#927B53] transition-transform duration-300 group-hover:text-[#4D351D] chevron rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 9-7 7-7-7"/></svg>
            </button>
            <div class="accordion-panel overflow-hidden transition-all duration-300 ease-in-out" style="max-height: 400px;">
              <div class="pb-5 pt-1 text-xs text-[#363638]/80 space-y-3 leading-relaxed">
                <p class="font-medium text-[#363638]">
                  Handmade &amp; packed with care. Dispatches in 2&ndash;3 working days.
                </p>
                <div class="space-y-2 pl-1 text-[11px]">
                  <div class="flex items-start gap-2">
                    <span class="w-5 h-5 rounded-full bg-[#4D351D] text-[#E9DFC2] flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5">1</span>
                    <div><strong>Day 1 &ndash; Atelier Inspection:</strong> Hand inspection of paper, ribbons, and spine stitching.</div>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="w-5 h-5 rounded-full bg-[#4D351D] text-[#E9DFC2] flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5">2</span>
                    <div><strong>Day 2 &ndash; Wax Seal Packaging:</strong> Wrapped in archival tissue paper, boxed in recycled kraft with a gold wax seal.</div>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="w-5 h-5 rounded-full bg-[#4D351D] text-[#E9DFC2] flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5">3</span>
                    <div><strong>Days 3-4 &ndash; Express Transit:</strong> Fast domestic air transit via Bluedart / Delhivery Express.</div>
                  </div>
                  <div class="flex items-start gap-2">
                    <span class="w-5 h-5 rounded-full bg-[#2D6A4F] text-white flex items-center justify-center text-[10px] font-bold flex-shrink-0 mt-0.5">4</span>
                    <div><strong>Day 5 &ndash; Doorstep Delivery:</strong> Live SMS &amp; WhatsApp tracking provided upon studio dispatch.</div>
                  </div>
                </div>
                <p class="text-[11px] text-[#2D6A4F] font-medium pt-1">✨ 100% plastic-free, recyclable protective honeycomb wrap.</p>
              </div>
            </div>
          </div>
        </div>

        <script>
          function toggleDetailsAccordion(button) {
            var panel = button.nextElementSibling;
            var chevron = button.querySelector('.chevron');
            var isOpen = panel.style.maxHeight && panel.style.maxHeight !== '0px';

            if (isOpen) {
              panel.style.maxHeight = '0px';
              if (chevron) chevron.classList.remove('rotate-180');
              button.classList.remove('active-accordion');
            } else {
              panel.style.maxHeight = panel.scrollHeight + 40 + 'px';
              if (chevron) chevron.classList.add('rotate-180');
              button.classList.add('active-accordion');
            }
          }
        </script>
      </div>
    </div>
  </div>

  <!-- =========================================================================
       Interactive Flip-Through Inner Pages Component (Digital Book Preview)
       ========================================================================= -->
  <section class="py-20 sm:py-24 bg-[#F8F5ED] border-t border-[#C6B58E]/30 overflow-hidden relative select-none" id="shopify-flip-through-section" aria-label="Interactive Journal Page Preview">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Section Heading: DM Serif Display, Espresso Charcoal (#363638), Generous Spacing -->
      <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
        <h2 class="font-serif-display text-3xl sm:text-4xl lg:text-5xl text-[#363638] tracking-tight">
          {{ section.settings.flip_heading | default: 'Flip through a few inner pages!' }}
        </h2>
      </div>

      <!-- Interactive Book Display Container with Realistic Desk Shadow & Spine -->
      <div class="relative mx-auto flex items-center justify-center p-3 sm:p-6 sm:pb-8 rounded-3xl bg-white/60 border border-[#C6B58E]/40 shadow-tactile-lg backdrop-blur-sm" id="shopify-flip-desk">
        
        <!-- Left & Right Hover Drag / Click Hints for Desktop -->
        <div class="hidden md:flex absolute top-4 left-6 items-center gap-1.5 text-[11px] font-semibold text-[#927B53]/70 pointer-events-none">
          <span>&larr; Drag corner or tap to turn back</span>
        </div>
        <div class="hidden md:flex absolute top-4 right-6 items-center gap-1.5 text-[11px] font-semibold text-[#927B53]/70 pointer-events-none">
          <span>Drag corner or tap to turn next &rarr;</span>
        </div>

        <!-- Canvas Mount Target for St.PageFlip -->
        <div id="shopify-page-flip-book" class="mx-auto flex items-center justify-center cursor-grab active:cursor-grabbing max-w-full"></div>
      </div>

      <!-- Navigation Controls ("< BACK" / "NEXT >") styled in Deep Coffee (#4D351D) -->
      <div class="flex items-center justify-center gap-4 sm:gap-6 mt-6 sm:mt-8">
        <button type="button" 
                id="shopify-flip-back" 
                onclick="changeShopifyFlip(-1)" 
                class="px-8 sm:px-10 py-3 rounded-full border border-[#4D351D]/30 text-[#4D351D]/40 bg-white/70 text-xs font-bold uppercase tracking-widest transition-all cursor-not-allowed select-none shadow-sm disabled:opacity-40" 
                aria-label="Previous Page"
                disabled>
          &lsaquo; Back
        </button>

        <button type="button" 
                id="shopify-flip-next" 
                onclick="changeShopifyFlip(1)" 
                class="px-8 sm:px-10 py-3 rounded-full border border-[#4D351D] bg-[#4D351D] text-[#E9DFC2] hover:bg-[#363638] text-xs font-bold uppercase tracking-widest transition-all shadow-tactile select-none hover:shadow-lg" 
                aria-label="Next Page">
          Next &rsaquo;
        </button>
      </div>

    </div>
  </section>

  <script src="{{ 'page-flip.browser.js' | asset_url }}"></script>
  <script>
    var shopifyFlipPages = [];

    {% if section.blocks.size > 0 %}
      {% for block in section.blocks %}
        {% if block.settings.page_image != blank %}
          shopifyFlipPages.push("{{ block.settings.page_image | image_url: width: 900 }}");
        {% endif %}
      {% endfor %}
    {% endif %}

    // Fallback to high-resolution atelier journal pages if no custom images uploaded in theme editor
    if (shopifyFlipPages.length === 0) {
      shopifyFlipPages = [
        "{{ 'flip_cover.jpg' | asset_url }}",
        "{{ 'flip_page_01_belonging.jpg' | asset_url }}",
        "{{ 'flip_page_02_vision.jpg' | asset_url }}",
        "{{ 'flip_page_03_monthly.jpg' | asset_url }}",
        "{{ 'flip_page_04_habits.jpg' | asset_url }}",
        "{{ 'flip_page_05_weekly_left.jpg' | asset_url }}",
        "{{ 'flip_page_06_weekly_right.jpg' | asset_url }}",
        "{{ 'flip_back_cover.jpg' | asset_url }}"
      ];
    }

    var currentShopifyFlip = 0;
    var shopifyPageFlip = null;

    function initShopifyPageFlip() {
      var bookEl = document.getElementById('shopify-page-flip-book');
      if (!bookEl || typeof St === 'undefined' || !St.PageFlip) return;

      var isMobile = window.innerWidth < 768;
      var width = isMobile ? Math.min(window.innerWidth - 64, 340) : 380;
      var height = Math.round(width * 1.333);

      try {
        shopifyPageFlip = new St.PageFlip(bookEl, {
          width: width,
          height: height,
          size: 'fixed',
          minWidth: 260,
          maxWidth: 440,
          minHeight: 347,
          maxHeight: 587,
          maxShadowOpacity: 0.55,
          showCover: true,
          mobileScrollSupport: true,
          usePortrait: true,
          flippingTime: 700,
          drawShadow: true,
          showPageCorners: true,
          useMouseEvents: true,
          disableFlipByClick: false
        });

        shopifyPageFlip.loadFromImages(shopifyFlipPages);

        shopifyPageFlip.on('flip', function(e) {
          currentShopifyFlip = e.data;
          updateShopifyFlip(currentShopifyFlip);
        });

        shopifyPageFlip.on('init', function() {
          updateShopifyFlip(0);
          mountShopifyPagePeel();
        });
      } catch (err) {
        console.warn('Shopify PageFlip init notice:', err);
      }
    }

    function mountShopifyPagePeel() {
      var bookEl = document.getElementById('shopify-page-flip-book');
      if (!bookEl) return;
      var parentEl = bookEl.querySelector('.stf__parent') || bookEl;
      var hint = document.getElementById('shopify-flip-page-peel-hint');
      if (!hint) {
        hint = document.createElement('div');
        hint.id = 'shopify-flip-page-peel-hint';
        hint.setAttribute('role', 'button');
        hint.setAttribute('aria-label', 'Turn to next page');
        hint.setAttribute('title', 'Tap corner to flip page');
        hint.onclick = function(e) {
          e.stopPropagation();
          changeShopifyFlip(1);
        };
        hint.innerHTML = `
          <div class="relative w-12 h-12 sm:w-14 sm:h-14 overflow-visible flex items-end justify-end group cursor-pointer">
            <div class="page-peel-fold w-10 h-10 sm:w-11 sm:h-11 bg-gradient-to-br from-[#EAE2D2] via-[#F8F5ED] to-[#DFD6C3] border-t border-l border-[#C6B58E] rounded-tl-lg flex items-end justify-end pb-1 pr-1 cursor-pointer transition-transform duration-300 group-hover:scale-110">
              <svg class="w-3.5 h-3.5 text-[#4D351D]/85 transition-transform duration-300 group-hover:rotate-12 group-hover:text-[#4D351D]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                <path d="M3 3v5h5"/>
              </svg>
            </div>
            <div class="absolute -top-7 right-0 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none bg-[#4D351D] text-[#E9DFC2] text-[10px] font-bold px-2 py-0.5 rounded-full shadow-md whitespace-nowrap">
              Flip page ›
            </div>
          </div>
        `;
        hint.className = 'absolute bottom-0 right-0 z-30 select-none cursor-pointer';
        parentEl.appendChild(hint);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initShopifyPageFlip);
    } else {
      initShopifyPageFlip();
    }

    function updateShopifyFlip(index) {
      if (typeof index === 'number') currentShopifyFlip = index;
      var prevBtn = document.getElementById('shopify-flip-back');
      var nextBtn = document.getElementById('shopify-flip-next');
      var peelHint = document.getElementById('shopify-flip-page-peel-hint');

      if (peelHint) {
        if (currentShopifyFlip === shopifyFlipPages.length - 1) {
          peelHint.style.display = 'none';
        } else {
          peelHint.style.display = 'block';
        }
      }

      if (prevBtn) {
        if (currentShopifyFlip === 0) {
          prevBtn.disabled = true;
          prevBtn.className = 'px-8 sm:px-10 py-3 rounded-full border border-[#4D351D]/30 text-[#4D351D]/40 bg-white/70 text-xs font-bold uppercase tracking-widest transition-all cursor-not-allowed select-none shadow-sm';
        } else {
          prevBtn.disabled = false;
          prevBtn.className = 'px-8 sm:px-10 py-3 rounded-full border border-[#4D351D] text-[#4D351D] bg-white hover:bg-[#4D351D] hover:text-[#E9DFC2] text-xs font-bold uppercase tracking-widest transition-all shadow-sm select-none hover:shadow';
        }
      }

      if (nextBtn) {
        if (currentShopifyFlip === shopifyFlipPages.length - 1) {
          nextBtn.disabled = true;
          nextBtn.className = 'px-8 sm:px-10 py-3 rounded-full border border-[#4D351D]/30 text-[#4D351D]/40 bg-white/70 text-xs font-bold uppercase tracking-widest transition-all cursor-not-allowed select-none shadow-sm';
        } else {
          nextBtn.disabled = false;
          nextBtn.className = 'px-8 sm:px-10 py-3 rounded-full border border-[#4D351D] bg-[#4D351D] text-[#E9DFC2] hover:bg-[#363638] text-xs font-bold uppercase tracking-widest transition-all shadow-tactile select-none hover:shadow-lg';
        }
      }
    }

    function changeShopifyFlip(delta) {
      if (shopifyPageFlip) {
        if (delta > 0) {
          shopifyPageFlip.flipNext('bottom');
        } else {
          shopifyPageFlip.flipPrev('bottom');
        }
      }
    }

    function goToShopifyFlip(idx) {
      if (shopifyPageFlip) {
        shopifyPageFlip.flip(idx, 'bottom');
      }
    }

    function scrollShopifyCarousel(dir) {
      const track = document.getElementById('shopify-carousel-track');
      if (!track) return;
      track.scrollBy({ left: dir * track.clientWidth, behavior: 'smooth' });
    }
  </script>

  <!-- Persistent Sticky Bottom Add-to-Cart Bar -->
  <aside id="shopify-sticky-pdp-bar" class="fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-[#C6B58E]/40 shadow-tactile-lg transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 sm:py-3 flex items-center justify-between gap-3 sm:gap-4">
      <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
        <img src="{{ product.featured_image | default: 'prod_journal.jpg' | asset_url }}" alt="{{ product.title | escape }}" class="w-10 h-10 sm:w-12 sm:h-12 rounded-lg object-cover border border-[#C6B58E]/40 flex-shrink-0" />
        <div class="min-w-0">
          <p class="text-xs sm:text-sm font-semibold text-[#363638] truncate max-w-[130px] sm:max-w-xs md:max-w-sm">{{ product.title | default: 'The 2027 Bound Chronicle' }}</p>
          <div class="flex items-baseline gap-1.5 sm:gap-2">
            <span class="font-serif-display text-base sm:text-xl font-bold text-[#4D351D]">{{ product.price | money | default: '₹1,299' }}</span>
            <span class="text-xs text-[#363638]/40 line-through hidden xs:inline">₹1,699</span>
            <span class="bg-[#C85A32]/10 text-[#C85A32] text-[10px] font-bold px-1.5 py-0.5 rounded-full hidden sm:inline">SAVE 24%</span>
          </div>
        </div>
      </div>
      <div class="flex items-center gap-2 flex-shrink-0">
        <button type="button" onclick="document.getElementById('journal-pdp-form').querySelector('button[name=add]').click()" class="btn-shimmer bg-[#4D351D] hover:bg-[#363638] text-[#E9DFC2] px-5 sm:px-8 py-2.5 sm:py-3.5 rounded-full font-bold text-xs sm:text-sm uppercase tracking-wider shadow-tactile transition-all active:scale-95 flex items-center gap-2">
          <svg class="w-4 h-4 text-[#E9DFC2] relative z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span class="whitespace-nowrap relative z-10">Add to Cart</span>
        </button>
      </div>
    </div>
  </aside>
</div>
{% schema %}
{
  "name": "Journal Luxury PDP",
  "settings": [
    {
      "type": "header",
      "content": "Flip-Through Inner Pages Settings"
    },
    {
      "type": "text",
      "id": "flip_heading",
      "label": "Heading",
      "default": "Flip through a few inner pages!"
    }
  ],
  "blocks": [
    {
      "type": "page_image",
      "name": "Journal Page Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "page_image",
          "label": "Page / Spread Image",
          "info": "Upload a portrait (3:4) high-resolution image of a journal page or cover. In theme editor, add as many pages as you like and drag to reorder."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal Luxury PDP",
      "blocks": [
        { "type": "page_image" },
        { "type": "page_image" },
        { "type": "page_image" },
        { "type": "page_image" },
        { "type": "page_image" },
        { "type": "page_image" },
        { "type": "page_image" },
        { "type": "page_image" }
      ]
    }
  ]
}
{% endschema %}
