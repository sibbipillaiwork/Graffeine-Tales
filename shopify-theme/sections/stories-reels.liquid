<section class="video-commerce-section" id="stories-in-motion" aria-label="Stories in Motion Shoppable Video Reels">
      <div class="container reels-container">
        
        <!-- Section Header with Navigation Controls -->
        <div class="reels-header-wrap">
          <div class="reels-header-info">
            <h2 class="reels-section-title">Art in Action, Stories in Motion.</h2>
          </div>

          <div class="reels-header-actions">
            <!-- Desktop Track Nav Arrows -->
            <div class="reels-nav-arrows" aria-label="Reels carousel navigation">
              <button class="reel-nav-btn prev" id="reels-prev-btn" onclick="scrollReelsTrack(-1)" aria-label="Previous reels">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="m15 18-6-6 6-6"/>
                </svg>
              </button>
              <button class="reel-nav-btn next" id="reels-next-btn" onclick="scrollReelsTrack(1)" aria-label="Next reels">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="m9 18 6-6-6-6"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Reels Carousel Track Wrapper -->
        <div class="reels-carousel-wrapper" id="reels-carousel-wrapper">
          <div class="reels-track" id="reels-track" role="region" aria-label="Shoppable video reels carousel">
            <!-- Dynamically populated via renderReels() in app.js -->
          </div>
        </div>

        <!-- Mobile Scroll Indicator / Pagination Dots -->
        <div class="reels-dots-wrap" id="reels-dots-wrap" aria-hidden="true"></div>

      </div>
    </section>

{% schema %}
{
  "name": "Stories in Motion (Shoppable Video Reels)",
  "settings": [],
  "presets": [
    {
      "name": "Stories in Motion (Shoppable Video Reels)"
    }
  ]
}
{% endschema %}
