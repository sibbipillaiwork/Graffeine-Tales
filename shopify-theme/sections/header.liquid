                  <li class="mega-subitem">
                    <a href="#catalogue-section">
                      <span class="sub-title">Wax Seals &amp; Stamps</span>
                      <span class="sub-desc">Solid brass with turned walnut handle</span>
                    </a>
                  </li>
                </ul>
              </div>
              <div class="mega-feature-card">
                <img src="{{ \'artist_calendar.jpg\' | asset_url }}" alt="Desk Calendar" class="mega-feature-img" />
                <span class="mega-feature-tag">Featured Drop</span>
                <h4 class="mega-feature-title">2026 Artist Desk Calender</h4>
              </div>
