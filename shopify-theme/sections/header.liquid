              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <div class="mega-menu">
              <div>
                <ul class="mega-sublist">
                  <li class="mega-subitem">
                    <a href="#catalogue-section">
                      <span class="sub-title">Desk Calendars &amp; Planners</span>
                      <span class="sub-desc">Progress Not Perfection &amp; animal editions</span>
                    </a>
                  </li>
                  <li class="mega-subitem">
                    <a href="#catalogue-section">
                      <span class="sub-title">Magnetic &amp; Wooden Bookmarks</span>
                      <span class="sub-desc">Tactile keepsakes for book lovers</span>
                    </a>
                  </li>
                  <li class="mega-subitem">
                    <a href="#catalogue-section">
                      <span class="sub-title">Laptop &amp; Phone Stickers</span>
                      <span class="sub-desc">Waterproof vinyl with witty desi pop art</span>
                    </a>
                  </li>
                  <li class="mega-subitem">
                    <a href="#catalogue-section">
                      <span class="sub-title">Letterpress Notecards</span>
                      <span class="sub-desc">Gold foil &amp; deckle edge cotton</span>
                    </a>
                  </li>
                  <li class="mega-subitem">
                    <a href="#catalogue-section">
