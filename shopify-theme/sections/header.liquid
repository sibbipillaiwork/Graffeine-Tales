          <!-- Category 5: Bulk Orders -->
          <li class="nav-item">
            <a href="#catalogue-section" class="nav-link">
              Bulk Orders
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <div class="mega-menu">
              <div>
                <ul class="mega-sublist">
                  <li class="mega-subitem">
                    <a href="#catalogue-section">
                      <span class="sub-title">Corporate Welcome Kits</span>
                      <span class="sub-desc">Branded coasters, calendars &amp; journals</span>
