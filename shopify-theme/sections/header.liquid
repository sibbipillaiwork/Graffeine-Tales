<header class="site-header" id="main-header">
    <div class="container nav-container">
      
      <!-- 1. Left: Hamburger Toggle (Mobile Only) -->
      <button class="mobile-toggle" id="mobile-toggle-btn" aria-label="Open mobile navigation menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/>
        </svg>
      </button>

      <!-- 2. Center: Brand Logo with Animated Coffee Cup (Center on Mobile, Left on Desktop) -->
      <a href="index.html" class="brand-logo-wrap" aria-label="Graffeine Tales Home">
        <div class="brand-cup-container">
          <div class="cup-steam-particles" aria-hidden="true">
            <span class="steam-wisp w1"></span>
            <span class="steam-wisp w2"></span>
          </div>
          <img src="{{ \'coffee_cup.png\' | asset_url }}" alt="Graffeine Coffee Cup Icon" class="brand-cup-img" />
        </div>
        <img src="{{ \'logo_dark.png\' | asset_url }}" alt="Graffeine Tales - Where Stories Become Art" class="brand-logo-img" />
      </a>

