                    </a>
                  </li>
                </ul>
              </div>
              <div class="mega-feature-card">
                <img src="{{ \'cat_journals.jpg\' | asset_url }}" alt="Linen Journals" class="mega-feature-img" />
                <span class="mega-feature-tag">Best of Studio</span>
