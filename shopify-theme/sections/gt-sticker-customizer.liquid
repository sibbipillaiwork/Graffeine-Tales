{% comment %}
  Graffeine Tales — Independent Device & Sticker Customizer Section
  Compatible with: Homepage (index.json), Collection (collection.json), PDPs

  Typography Hierarchy (Strict Brand Guidelines):
    - Primary Display Serif: 'DM Serif Display', Georgia, serif
    - Secondary Editorial Serif: 'Playfair Display', serif
    - Clean UI Sans: 'Inter', -apple-system, sans-serif
    - Tactile Script Accent: 'Patrick Hand', cursive
    - Badges & Pills: 'Quicksand', sans-serif

  Brand Color Tokens:
    - Warm Paper: #F8F5ED
    - Espresso Charcoal: #363638
    - Logo Cream: #E9DFC2
    - Sand: #C6B58E
    - Deep Coffee: #4D351D
    - Gold Wax: #D4AF37
    - Sage Craft: #2D6A4F
{% endcomment %}

<!-- Google Fonts Strict Import -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&family=Patrick+Hand&family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">

{%- style -%}
  #gt-customizer-{{ section.id }} {
    --gt-bg: {{ section.settings.bg_color | default: '#363638' }};
    --gt-text: {{ section.settings.text_color | default: '#E9DFC2' }};
    --gt-sand: #C6B58E;
    --gt-coffee: #4D351D;
    --gt-gold: #D4AF37;
    --gt-paper: #F8F5ED;
    --gt-font-display: 'DM Serif Display', Georgia, serif;
    --gt-font-editorial: 'Playfair Display', serif;
    --gt-font-ui: 'Inter', -apple-system, sans-serif;
    --gt-font-script: 'Patrick Hand', cursive;
    --gt-font-pill: 'Quicksand', sans-serif;

    background-color: var(--gt-bg);
    color: var(--gt-text);
    font-family: var(--gt-font-ui);
    position: relative;
    overflow: hidden;
    padding: {{ section.settings.padding_top | default: 60 }}px 16px {{ section.settings.padding_bottom | default: 80 }}px;
  }

  /* Radial ambient studio glow */
  #gt-customizer-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, rgba(77, 53, 29, 0.4) 0%, rgba(54, 54, 56, 0.95) 60%, rgba(30, 29, 29, 1) 100%);
    pointer-events: none;
    z-index: 1;
  }

  .gt-customizer-inner {
    position: relative;
    z-index: 2;
    max-width: 1240px;
    margin: 0 auto;
  }

  /* Section Header */
  .gt-customizer-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 2.5rem;
  }

  .gt-customizer-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--gt-font-pill);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gt-text);
    background: rgba(77, 53, 29, 0.7);
    border: 1px solid var(--gt-sand);
    backdrop-filter: blur(8px);
    padding: 0.35rem 1.15rem;
    border-radius: 9999px;
    margin-bottom: 0.85rem;
  }

  .gt-customizer-title {
    font-family: var(--gt-font-display);
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.12;
    color: var(--gt-text);
    font-weight: 400;
    margin: 0 0 0.85rem;
    letter-spacing: 0.01em;
  }

  .gt-customizer-subtitle {
    font-family: var(--gt-font-editorial);
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.6;
    color: #C6B58E;
    font-style: italic;
    margin: 0;
  }

  .gt-customizer-script-note {
    font-family: var(--gt-font-script);
    font-size: 1.25rem;
    color: var(--gt-gold);
    display: block;
    margin-top: 0.5rem;
  }

  /* Controls Bar: Device Tabs & Color Switcher */
  .gt-customizer-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(198, 181, 142, 0.35);
    backdrop-filter: blur(12px);
    border-radius: 9999px;
    padding: 0.5rem 0.85rem;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .gt-customizer-toolbar {
      border-radius: 1.25rem;
      justify-content: center;
    }
  }

  /* Device Selector Tabs */
  .gt-device-tabs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .gt-device-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--gt-font-ui);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--gt-text);
    background: transparent;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .gt-device-tab-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .gt-device-tab-btn.is-active {
    background: var(--gt-coffee);
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(77, 53, 29, 0.4);
  }

  /* Color Variant Switcher */
  .gt-color-switcher {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .gt-color-label {
    font-family: var(--gt-font-pill);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(233, 223, 194, 0.7);
    margin-right: 0.35rem;
  }

  .gt-color-dot {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    padding: 0;
    position: relative;
  }

  .gt-color-dot:hover {
    transform: scale(1.15);
  }

  .gt-color-dot.is-active {
    border-color: var(--gt-sand);
    box-shadow: 0 0 0 2px var(--gt-coffee);
    transform: scale(1.12);
  }

  /* Action Buttons Toolbar */
  .gt-action-buttons {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .gt-btn-action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--gt-font-ui);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--gt-text);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(198, 181, 142, 0.3);
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .gt-btn-action:hover {
    background: rgba(255, 255, 255, 0.16);
    border-color: var(--gt-sand);
  }

  /* ========================================================
     DEVICE STAGE & DROPZONE MOCKUPS
     ======================================================== */
  .gt-stage-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-bottom: 2.5rem;
    min-height: 440px;
  }

  .gt-device-chassis {
    position: relative;
    user-select: none;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* 1. MacBook Mockup */
  .gt-device-chassis[data-device="macbook"] {
    width: min(100%, 680px);
    aspect-ratio: 16 / 10;
    border-radius: 20px;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  /* 2. iPad Mockup */
  .gt-device-chassis[data-device="ipad"] {
    width: min(85%, 440px);
    aspect-ratio: 4 / 3;
    border-radius: 24px;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.65), 0 0 0 1px rgba(255, 255, 255, 0.12);
  }

  /* 3. iPhone 18 Pro Max Mockup */
  .gt-device-chassis[data-device="iphone"] {
    width: min(70%, 300px);
    aspect-ratio: 9 / 18.5;
    border-radius: 42px;
    box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.65), 0 0 0 2px rgba(255, 255, 255, 0.14);
  }

  /* Glowing drop zone active highlight */
  .gt-device-chassis.drop-hover {
    box-shadow: 0 0 0 4px var(--gt-gold), 0 0 30px rgba(212, 175, 55, 0.4) !important;
  }

  /* Chassis Details */
  .gt-chassis-reflection {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.02) 45%, rgba(0, 0, 0, 0.15) 100%);
    pointer-events: none;
    z-index: 2;
  }

  /* Center Apple Logo */
  .gt-chassis-logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    z-index: 3;
    transition: opacity 0.3s ease;
  }

  .gt-chassis-logo svg {
    width: 48px;
    height: 48px;
    filter: drop-shadow(0 1px 2px rgba(255, 255, 255, 0.25));
  }

  /* iPhone Camera Plateau (Triple Lens) */
  .gt-iphone-camera-plateau {
    display: none;
    position: absolute;
    top: 14px;
    left: 14px;
    width: 96px;
    height: 98px;
    border-radius: 24px;
    background: inherit;
    filter: brightness(0.92);
    box-shadow: 2px 4px 14px rgba(0, 0, 0, 0.35), inset 0 0 0 1px rgba(255, 255, 255, 0.18);
    pointer-events: none;
    z-index: 4;
  }

  .gt-device-chassis[data-device="iphone"] .gt-iphone-camera-plateau {
    display: block;
  }

  .gt-camera-lens {
    position: absolute;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #111;
    border: 2px solid rgba(255, 255, 255, 0.3);
    box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.8);
  }
  .gt-camera-lens.top-left { top: 12px; left: 12px; }
  .gt-camera-lens.bottom-left { bottom: 12px; left: 12px; }
  .gt-camera-lens.mid-right { top: 32px; right: 12px; }

  .gt-camera-flash {
    position: absolute;
    top: 14px;
    right: 18px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #FFF9E6;
    border: 1px solid rgba(0, 0, 0, 0.2);
  }

  .gt-camera-lidar {
    position: absolute;
    bottom: 16px;
    right: 18px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #090909;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  /* MacBook Bottom Display Hinge */
  .gt-laptop-hinge {
    display: none;
    width: 120px;
    height: 7px;
    margin: -4px auto 0;
    border-radius: 0 0 8px 8px;
    background: #888;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.5);
    transition: background 0.3s ease;
  }

  .gt-device-chassis[data-device="macbook"] + .gt-laptop-hinge {
    display: block;
  }

  /* Device Watermark Instructions */
  .gt-chassis-hint {
    position: absolute;
    bottom: 14px;
    inset-x: 0;
    text-align: center;
    font-family: var(--gt-font-ui);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.55);
    pointer-events: none;
    z-index: 3;
  }

  /* Mount Zone for dropped stickers */
  .gt-stickers-mount {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: inherit;
    z-index: 5;
    pointer-events: none;
  }

  /* ========================================================
     STICKER TRAY (PICKUP ZONE)
     ======================================================== */
  .gt-tray-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(198, 181, 142, 0.25);
    border-radius: 24px;
    padding: 1.5rem;
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  }

  .gt-tray-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(198, 181, 142, 0.2);
  }

  .gt-tray-title {
    font-family: var(--gt-font-display);
    font-size: 1.25rem;
    color: var(--gt-text);
    margin: 0;
    font-weight: 400;
  }

  .gt-tray-status {
    font-family: var(--gt-font-ui);
    font-size: 0.75rem;
    color: var(--gt-sand);
    font-weight: 500;
  }

  .gt-tray-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    min-height: 140px;
    padding: 0.5rem;
  }

  /* Die-Cut Vinyl Sticker Items */
  .gt-die-cut-sticker {
    position: relative;
    width: 82px;
    height: 82px;
    cursor: grab;
    user-select: none;
    -webkit-user-drag: none;
    touch-action: none;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1), filter 0.2s ease;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.3));
    pointer-events: auto;
  }

  @media (min-width: 640px) {
    .gt-die-cut-sticker {
      width: 94px;
      height: 94px;
    }
  }

  .gt-die-cut-sticker:hover {
    transform: scale(1.08) rotate(3deg);
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.45));
  }

  .gt-die-cut-sticker.is-dragging {
    cursor: grabbing;
    position: fixed !important;
    z-index: 99999 !important;
    transition: none !important;
    filter: drop-shadow(0 20px 30px rgba(0, 0, 0, 0.5)) !important;
  }

  .gt-die-cut-sticker.placed-on-device {
    position: absolute !important;
    cursor: move;
  }

  .gt-sticker-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    pointer-events: none;
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.85));
  }

  /* Toast Notification */
  .gt-customizer-toast {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100000;
    background: #363638;
    color: #E9DFC2;
    border: 1px solid var(--gt-sand);
    padding: 0.65rem 1.25rem;
    border-radius: 9999px;
    font-family: var(--gt-font-ui);
    font-size: 0.8125rem;
    font-weight: 500;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: translateY(12px);
    transition: all 0.25s ease;
    pointer-events: none;
  }
  .gt-customizer-toast.show {
    opacity: 1;
    transform: translateY(0);
  }
{%- style -%}

<section id="gt-customizer-{{ section.id }}" aria-label="Interactive Device and Sticker Customizer">
  <div class="gt-customizer-inner">

    <!-- Section Heading -->
    <div class="gt-customizer-header">
      {%- if section.settings.badge != blank -%}
        <span class="gt-customizer-badge">{{ section.settings.badge }}</span>
      {%- endif -%}

      <h2 class="gt-customizer-title">{{ section.settings.title | default: 'Style Your Tech with Studio Vinyl' }}</h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="gt-customizer-subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <span class="gt-customizer-script-note">Drag, drop &amp; double-click stickers to rotate</span>
    </div>

    <!-- Controls Toolbar: Device Selector, Color Variants & Action Tools -->
    <div class="gt-customizer-toolbar">
      
      <!-- Device Switcher Tabs -->
      <div class="gt-device-tabs" role="tablist">
        <button type="button" class="gt-device-tab-btn is-active" data-device="macbook" onclick="gtSwitchDevice('{{ section.id }}', 'macbook')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/></svg>
          <span>MacBook</span>
        </button>

        <button type="button" class="gt-device-tab-btn" data-device="ipad" onclick="gtSwitchDevice('{{ section.id }}', 'ipad')">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2"/><circle cx="12" cy="18" r="0.5"/></svg>
          <span>iPad</span>
        </button>

        <button type="button" class="gt-device-tab-btn" data-device="iphone" onclick="gtSwitchDevice('{{ section.id }}', 'iphone')">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="3"/><path d="M12 18h.01"/></svg>
          <span>iPhone 18 Pro Max</span>
        </button>
      </div>

      <!-- Color Variant Switcher -->
      <div class="gt-color-switcher" id="gt-color-switcher-{{ section.id }}">
        <span class="gt-color-label">Finish:</span>
        <div id="gt-color-dots-{{ section.id }}" style="display:flex;gap:6px;">
          <!-- Dynamically populated per device -->
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="gt-action-buttons">
        <button type="button" class="gt-btn-action" onclick="gtAutoCollage('{{ section.id }}')" title="Auto-arrange stickers into aesthetic composition">
          <span>✨ Auto-Collage</span>
        </button>
        <button type="button" class="gt-btn-action" onclick="gtResetTray('{{ section.id }}')" title="Return all stickers back to tray">
          <span>🔄 Reset</span>
        </button>
      </div>

    </div>

    <!-- Device Stage & Drop Mount -->
    <div class="gt-stage-wrapper">
      
      <!-- Device Shell (Defaults to MacBook) -->
      <div class="gt-device-chassis" id="gt-chassis-{{ section.id }}" data-device="macbook">
        
        <!-- Brushed Reflection -->
        <div class="gt-chassis-reflection"></div>

        <!-- Center Apple Insignia -->
        <div class="gt-chassis-logo">
          <svg viewBox="0 0 24 24" fill="currentColor" id="gt-apple-logo-{{ section.id }}">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 4.15c.66-.8 1.11-1.92.99-3.04-1 .04-2.14.65-2.82 1.45-.6.69-1.12 1.83-.98 2.94 1.12.09 2.15-.55 2.81-1.35z"/>
          </svg>
        </div>

        <!-- iPhone 18 Pro Max Triple Lens Plateau -->
        <div class="gt-iphone-camera-plateau">
          <div class="gt-camera-lens top-left"></div>
          <div class="gt-camera-lens bottom-left"></div>
          <div class="gt-camera-lens mid-right"></div>
          <div class="gt-camera-flash"></div>
          <div class="gt-camera-lidar"></div>
        </div>

        <!-- Watermark / Hint -->
        <div class="gt-chassis-hint" id="gt-chassis-hint-{{ section.id }}">
          ✦ Drag stickers onto device lid • Double-click sticker to rotate ✦
        </div>

        <!-- Stickers Mount Layer -->
        <div class="gt-stickers-mount" id="gt-mount-{{ section.id }}"></div>

      </div>

      <!-- MacBook Hinge -->
      <div class="gt-laptop-hinge" id="gt-hinge-{{ section.id }}"></div>

    </div>

    <!-- Sticker Tray (Pickup Zone) -->
    <div class="gt-tray-card">
      <div class="gt-tray-header">
        <h3 class="gt-tray-title">Studio Die-Cut Vinyl Tray</h3>
        <span class="gt-tray-status" id="gt-tray-count-{{ section.id }}">
          {{ section.blocks.size }} Vinyl Stickers Ready
        </span>
      </div>

      <div class="gt-tray-grid" id="gt-tray-{{ section.id }}">
        
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign sticker_img = block.settings.sticker_image
              assign sticker_title = block.settings.title | default: 'Studio Sticker'
            -%}
            <div class="gt-die-cut-sticker" 
                 id="gt-stk-{{ block.id }}" 
                 data-title="{{ sticker_title | escape }}"
                 data-block-id="{{ block.id }}"
                 data-rot="0"
                 {{ block.shopify_attributes }}>
              {%- if sticker_img != blank -%}
                {{ sticker_img | image_url: width: 240, height: 240 | image_tag: 
                  loading: 'lazy', 
                  class: 'gt-sticker-img',
                  alt: sticker_title | escape 
                }}
              {%- else -%}
                <div style="width:100%;height:100%;border-radius:12px;background:#E9DFC2;display:flex;align-items:center;justify-content:center;color:#4D351D;font-weight:700;font-size:11px;text-align:center;padding:4px;border:2px dashed #C6B58E;">
                  {{ sticker_title }}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <!-- Fallback 10 default studio stickers if no blocks added yet -->
          {%- for i in (1..10) -%}
            <div class="gt-die-cut-sticker" id="gt-stk-fallback-{{ i }}" data-title="Artisan Sticker #{{ i }}" data-rot="0">
              <div style="width:100%;height:100%;border-radius:12px;background:#E9DFC2;display:flex;align-items:center;justify-content:center;color:#4D351D;font-weight:700;font-size:12px;box-shadow:0 2px 8px rgba(0,0,0,0.2);">
                ✦ #{{ i }}
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}

      </div>
    </div>

  </div>

  <div class="gt-customizer-toast" id="gt-toast-{{ section.id }}"></div>
</section>

<script>
  (function() {
    const sId = '{{ section.id }}';

    // Device Color Variants Configuration
    const deviceConfigs = {
      macbook: {
        name: 'MacBook',
        colors: [
          { id: 'spacegray', name: 'Space Gray', hex: '#53565A', logo: '#989BA3', hinge: '#484A50' },
          { id: 'silver', name: 'Silver', hex: '#E3E4E6', logo: '#8E9094', hinge: '#B5B8BE' },
          { id: 'midnight', name: 'Midnight Navy', hex: '#1E242B', logo: '#333E4F', hinge: '#161B22' },
          { id: 'starlight', name: 'Starlight Champagne', hex: '#E5DED3', logo: '#A69E8E', hinge: '#BDB5A7' }
        ]
      },
      ipad: {
        name: 'iPad',
        colors: [
          { id: 'spacegray', name: 'Space Gray', hex: '#4B4D52', logo: '#989BA3' },
          { id: 'silver', name: 'Silver', hex: '#E3E4E6', logo: '#8E9094' },
          { id: 'starlight', name: 'Starlight', hex: '#E6E0D6', logo: '#A8A093' },
          { id: 'skyblue', name: 'Sky Blue', hex: '#A8BDCD', logo: '#688296' }
        ]
      },
      iphone: {
        name: 'iPhone 18 Pro Max',
        colors: [
          { id: 'desert', name: 'Desert Titanium', hex: '#C5B5A5', logo: '#8F7E6D' },
          { id: 'natural', name: 'Natural Titanium', hex: '#9E9992', logo: '#69645E' },
          { id: 'white', name: 'White Titanium', hex: '#ECEAE6', logo: '#B3B0AB' },
          { id: 'black', name: 'Black Titanium', hex: '#2C2B29', logo: '#1A1918' }
        ]
      }
    };

    let currentDevice = 'macbook';
    let currentColorIndex = 0;

    // Drag & Drop State
    let activeDragEl = null;
    let dragOffset = { x: 0, y: 0 };
    let isDragging = false;

    // Toast helper
    function showToast(msg) {
      const toast = document.getElementById('gt-toast-' + sId);
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2200);
    }

    // Switch Device Layout
    window.gtSwitchDevice = function(sectionId, deviceKey) {
      if (sectionId !== sId || !deviceConfigs[deviceKey]) return;
      currentDevice = deviceKey;
      currentColorIndex = 0;

      // Update Tab Buttons
      const root = document.getElementById('gt-customizer-' + sId);
      root.querySelectorAll('.gt-device-tab-btn').forEach(btn => {
        btn.classList.toggle('is-active', btn.getAttribute('data-device') === deviceKey);
      });

      // Update Chassis Model
      const chassis = document.getElementById('gt-chassis-' + sId);
      chassis.setAttribute('data-device', deviceKey);

      // Re-populate Color Dots
      renderColorDots();
      applyColor(0);

      showToast(`Switched to ${deviceConfigs[deviceKey].name}`);
    };

    function renderColorDots() {
      const container = document.getElementById('gt-color-dots-' + sId);
      if (!container) return;
      container.innerHTML = '';

      const colors = deviceConfigs[currentDevice].colors;
      colors.forEach((col, idx) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'gt-color-dot' + (idx === currentColorIndex ? ' is-active' : '');
        dot.style.backgroundColor = col.hex;
        dot.title = col.name;
        dot.onclick = () => applyColor(idx);
        container.appendChild(dot);
      });
    }

    function applyColor(idx) {
      currentColorIndex = idx;
      const config = deviceConfigs[currentDevice].colors[idx];
      const chassis = document.getElementById('gt-chassis-' + sId);
      const logo = document.getElementById('gt-apple-logo-' + sId);
      const hinge = document.getElementById('gt-hinge-' + sId);

      chassis.style.backgroundColor = config.hex;
      if (logo) logo.style.color = config.logo;
      if (hinge && config.hinge) hinge.style.backgroundColor = config.hinge;

      // Update active dot indicator
      const dots = document.querySelectorAll('#gt-color-dots-' + sId + ' .gt-color-dot');
      dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
    }

    // Drag-and-drop system using Pointer Events
    function initDragEngine() {
      const stickers = document.querySelectorAll('#gt-customizer-' + sId + ' .gt-die-cut-sticker');
      stickers.forEach(el => {
        el.addEventListener('pointerdown', (e) => startDrag(e, el));
      });

      // Double-click/tap to rotate placed sticker
      document.addEventListener('dblclick', (e) => {
        const sticker = e.target.closest('#gt-mount-' + sId + ' .gt-die-cut-sticker');
        if (sticker) {
          let rot = (parseFloat(sticker.getAttribute('data-rot') || '0') + 15) % 360;
          sticker.setAttribute('data-rot', rot);
          sticker.style.transform = `rotate(${rot}deg) scale(1)`;
        }
      });
    }

    function startDrag(e, element) {
      if (e.button && e.button !== 0) return;
      e.preventDefault();
      e.stopPropagation();

      activeDragEl = element;
      isDragging = true;

      const rect = element.getBoundingClientRect();
      dragOffset.x = e.clientX - rect.left;
      dragOffset.y = e.clientY - rect.top;

      element.classList.add('is-dragging');
      element.style.left = (e.clientX - dragOffset.x) + 'px';
      element.style.top = (e.clientY - dragOffset.y) + 'px';
      document.body.appendChild(element);

      window.addEventListener('pointermove', onPointerMove, { passive: false });
      window.addEventListener('pointerup', onPointerUp, { once: true });
      window.addEventListener('pointercancel', onPointerUp, { once: true });
    }

    function onPointerMove(e) {
      if (!isDragging || !activeDragEl) return;
      e.preventDefault();

      activeDragEl.style.left = (e.clientX - dragOffset.x) + 'px';
      activeDragEl.style.top = (e.clientY - dragOffset.y) + 'px';

      const chassis = document.getElementById('gt-chassis-' + sId);
      if (chassis) {
        const r = chassis.getBoundingClientRect();
        const isOver = (e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom);
        chassis.classList.toggle('drop-hover', isOver);
      }
    }

    function onPointerUp(e) {
      if (!isDragging || !activeDragEl) return;
      isDragging = false;
      window.removeEventListener('pointermove', onPointerMove);

      const chassis = document.getElementById('gt-chassis-' + sId);
      const mount = document.getElementById('gt-mount-' + sId);
      const tray = document.getElementById('gt-tray-' + sId);

      if (chassis) chassis.classList.remove('drop-hover');
      activeDragEl.classList.remove('is-dragging');

      const r = chassis.getBoundingClientRect();
      const dropX = e.clientX;
      const dropY = e.clientY;

      const isInside = (dropX >= r.left && dropX <= r.right && dropY >= r.top && dropY <= r.bottom);

      if (isInside && mount) {
        // Place on device
        mount.appendChild(activeDragEl);
        activeDragEl.classList.add('placed-on-device');

        const relX = ((dropX - dragOffset.x - r.left) / r.width) * 100;
        const relY = ((dropY - dragOffset.y - r.top) / r.height) * 100;

        activeDragEl.style.position = 'absolute';
        activeDragEl.style.left = Math.max(2, Math.min(80, relX)) + '%';
        activeDragEl.style.top = Math.max(2, Math.min(80, relY)) + '%';

        let rot = parseFloat(activeDragEl.getAttribute('data-rot') || '0');
        if (rot === 0) {
          rot = (Math.random() * 24 - 12); // subtle natural random tilt
          activeDragEl.setAttribute('data-rot', rot);
        }
        activeDragEl.style.transform = `rotate(${rot}deg) scale(1)`;

        showToast(`Stuck "${activeDragEl.getAttribute('data-title') || 'Sticker'}" to ${deviceConfigs[currentDevice].name}`);
      } else {
        // Return to tray
        tray.appendChild(activeDragEl);
        activeDragEl.classList.remove('placed-on-device');
        activeDragEl.style.position = 'relative';
        activeDragEl.style.left = 'auto';
        activeDragEl.style.top = 'auto';
        activeDragEl.style.transform = 'none';
        activeDragEl.setAttribute('data-rot', '0');
      }

      updateTrayCounter();
      activeDragEl = null;
    }

    // Auto-Collage Algorithm
    window.gtAutoCollage = function(sectionId) {
      if (sectionId !== sId) return;
      const mount = document.getElementById('gt-mount-' + sId);
      const tray = document.getElementById('gt-tray-' + sId);
      const allStickers = Array.from(document.querySelectorAll('#gt-customizer-' + sId + ' .gt-die-cut-sticker'));

      const layouts = [
        { left: '14%', top: '16%', rot: -9 },
        { left: '62%', top: '18%', rot: 12 },
        { left: '38%', top: '55%', rot: -6 },
        { left: '16%', top: '64%', rot: 14 },
        { left: '68%', top: '62%', rot: -11 },
        { left: '42%', top: '15%', rot: 7 },
        { left: '20%', top: '40%', rot: -15 }
      ];

      allStickers.forEach((stk, i) => {
        if (i < layouts.length) {
          mount.appendChild(stk);
          stk.classList.add('placed-on-device');
          stk.style.position = 'absolute';
          stk.style.left = layouts[i].left;
          stk.style.top = layouts[i].top;
          stk.setAttribute('data-rot', layouts[i].rot);
          stk.style.transform = `rotate(${layouts[i].rot}deg) scale(1)`;
        } else {
          tray.appendChild(stk);
          stk.classList.remove('placed-on-device');
          stk.style.position = 'relative';
          stk.style.left = 'auto';
          stk.style.top = 'auto';
          stk.style.transform = 'none';
          stk.setAttribute('data-rot', '0');
        }
      });

      updateTrayCounter();
      showToast('✨ Auto-Collaged with studio aesthetics');
    };

    // Reset Tray
    window.gtResetTray = function(sectionId) {
      if (sectionId !== sId) return;
      const tray = document.getElementById('gt-tray-' + sId);
      const placed = document.querySelectorAll('#gt-mount-' + sId + ' .gt-die-cut-sticker');
      placed.forEach(stk => {
        tray.appendChild(stk);
        stk.classList.remove('placed-on-device');
        stk.style.position = 'relative';
        stk.style.left = 'auto';
        stk.style.top = 'auto';
        stk.style.transform = 'none';
        stk.setAttribute('data-rot', '0');
      });
      updateTrayCounter();
      showToast('Returned all stickers to tray');
    };

    function updateTrayCounter() {
      const counter = document.getElementById('gt-tray-count-' + sId);
      const remaining = document.querySelectorAll('#gt-tray-' + sId + ' .gt-die-cut-sticker').length;
      if (counter) counter.textContent = `${remaining} Stickers in Tray`;
    }

    // Initialization
    document.addEventListener('DOMContentLoaded', () => {
      renderColorDots();
      applyColor(0);
      initDragEngine();
      updateTrayCounter();
    });
  })();
</script>

