<section class="hero-carousel-section" id="hero" aria-label="Hero Showcase Carousel">
      <div class="hero-carousel" id="hero-carousel">
        
        <!-- Track / Slides (Pure Imagery, No Text/Buttons) -->
        <div class="hero-carousel-track" id="hero-carousel-track">
          <!-- Slide 1: Journal & Coffee Rituals Flatlay -->
          <div class="hero-carousel-slide active" data-index="0">
            <img src="{{ \'hero_banner.jpg\' | asset_url }}" alt="Artisanal stationery and open linen journal flatlay" class="hero-carousel-img" />
          </div>
          <!-- Slide 2: Stacked Linen & Leather Journals -->
          <div class="hero-carousel-slide" data-index="1">
            <img src="{{ \'cat_journals.jpg\' | asset_url }}" alt="Handcrafted linen and leather journals stacked beside espresso" class="hero-carousel-img" />
          </div>
          <!-- Slide 3: Botanical Stationery & Wax Seal Suite -->
          <div class="hero-carousel-slide" data-index="2">
            <img src="{{ \'cat_stationaries.jpg\' | asset_url }}" alt="Botanical stationery, gold foiled cards, wax seal and bookmark" class="hero-carousel-img" />
          </div>
        </div>

        <!-- Navigation Arrows (Left & Right) -->
        <button class="hero-carousel-arrow hero-arrow-prev" id="hero-prev-btn" aria-label="Previous Slide">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button class="hero-carousel-arrow hero-arrow-next" id="hero-next-btn" aria-label="Next Slide">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>

        <!-- Scroll Bubbles / Indicator Dots -->
        <div class="hero-carousel-dots" id="hero-carousel-dots" role="tablist" aria-label="Slide indicators">
          <button class="carousel-dot active" data-slide="0" aria-label="Slide 1"></button>
          <button class="carousel-dot" data-slide="1" aria-label="Slide 2"></button>
          <button class="carousel-dot" data-slide="2" aria-label="Slide 3"></button>
        </div>

      </div>
    </section>

{% schema %}
{
  "name": "Hero Banner Showcase",
  "settings": [],
  "presets": [
    {
      "name": "Hero Banner Showcase"
    }
  ]
}
{% endschema %}
