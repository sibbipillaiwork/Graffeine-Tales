<div class="reel-viewer-overlay" id="reel-viewer-modal" role="dialog" aria-modal="true" aria-label="Shoppable Reel Theater" style="display: none;">
    <div class="reel-viewer-backdrop" onclick="closeReelViewerModal()"></div>
    
    <div class="reel-viewer-dialog">
      <!-- Close Button -->
      <button class="reel-viewer-close-btn" onclick="closeReelViewerModal()" aria-label="Close Reel Viewer">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>

      <!-- Prev / Next Navigation Arrows -->
      <button class="reel-viewer-nav-btn prev" onclick="navigateViewerReel(-1)" aria-label="Previous Reel">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="reel-viewer-nav-btn next" onclick="navigateViewerReel(1)" aria-label="Next Reel">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>

      <!-- Main 9:16 Video Stage -->
      <div class="reel-viewer-stage" id="reel-viewer-stage">
        
        <!-- Video Element / Embedded Frame -->
        <div class="reel-stage-media-wrap">
          <video class="reel-stage-video" id="reel-viewer-video" loop playsinline></video>
          <iframe class="reel-stage-iframe" id="reel-viewer-iframe" allowfullscreen style="display: none;"></iframe>
          <div class="reel-stage-poster-fallback" id="reel-viewer-poster-fallback"></div>
          
          <!-- Tap to Play / Pause Overlay -->
          <div class="reel-stage-tap-zone" onclick="toggleViewerPlayPause()">
            <div class="reel-stage-play-badge" id="reel-viewer-play-badge">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 3 20 12 6 21 6 3"></polygon></svg>
            </div>
          </div>
        </div>

{% schema %}
{
  "name": "Shoppable Reels 9:16 Theater Modal",
  "settings": []
}
{% endschema %}
